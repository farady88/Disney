 CREATE TABLE Movies (
    MovieID INT PRIMARY KEY,
    Title NVARCHAR(255),
    Franchise NVARCHAR(255),
    Runtime INT,
    Rating NVARCHAR(50),
    Language NVARCHAR(50),
    Genre NVARCHAR(50),
    Country NVARCHAR(50),
    Release_Date DATE
);


CREATE TABLE People (
    PeopleID INT PRIMARY KEY,
    Name NVARCHAR(255),
    Role NVARCHAR(50)
);


CREATE TABLE Financials (
    FinancialID INT PRIMARY KEY,
    MovieID INT UNIQUE,
    budget_million_usd MONEY,
    box_office_million_usd MONEY,
    production_cost_million_usd MONEY,
    marketing_cost MONEY,
    roi_percent FLOAT,
    international_box_office_million_usd MONEY,

    FOREIGN KEY (MovieID) REFERENCES Movies(MovieID)
);


CREATE TABLE Metrics (
    MetricsID INT PRIMARY KEY,
    MovieID INT UNIQUE,
    imdb_rating FLOAT,
    rotten_tomatoes_rating FLOAT,
    metacritic_score FLOAT,
    audience_score FLOAT,

    FOREIGN KEY (MovieID) REFERENCES Movies(MovieID)
);


CREATE TABLE MoviePeople (
    MovieID INT,
    PeopleID INT,

    PRIMARY KEY (MovieID, PeopleID),

    FOREIGN KEY (MovieID) REFERENCES Movies(MovieID),
    FOREIGN KEY (PeopleID) REFERENCES People(PeopleID)
);
